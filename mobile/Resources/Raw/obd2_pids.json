  "formulas": {
    "a_identity": { "description": "value = A", "args": "A" },
    "a_bitmask": { "description": "Побитовая маска из A", "args": "A" },
    "a_hi_b_lo": { "description": "Старший/младший полубайт A и B", "args": "A,B" },
    "a_percent": { "description": "value = A × 100 / 255", "args": "A" },
    "a_sub_40": { "description": "value = A − 40", "args": "A" },
    "a_sub128_percent": { "description": "value = (A − 128) × 100 / 128", "args": "A" },
    "a_mul_3": { "description": "value = A × 3", "args": "A" },
    "a_div2_sub64": { "description": "value = A / 2 − 64", "args": "A" },
    "a_div200": { "description": "value = A / 200", "args": "A" },
    "a_sub125": { "description": "value = A − 125", "args": "A" },
    "ab_identity": { "description": "value = (A × 256) + B", "args": "A,B" },
    "ab_div_4": { "description": "value = ((A × 256) + B) / 4", "args": "A,B" },
    "ab_div_4_mul_10": { "description": "value = ((A × 256) + B) × 10 / 4", "args": "A,B" },
    "ab_div_10_sub40": { "description": "value = ((A × 256) + B) / 10 − 40", "args": "A,B" },
    "ab_div_20": { "description": "value = ((A × 256) + B) / 20", "args": "A,B" },
    "ab_div_100": { "description": "value = ((A × 256) + B) / 100", "args": "A,B" },
    "ab_div_255": { "description": "value = ((A × 256) + B) / 255", "args": "A,B" },
    "ab_div_256": { "description": "value = ((A × 256) + B) / 256", "args": "A,B" },
    "ab_div_512_sub128": { "description": "value = ((A × 256) + B) / 512 − 128", "args": "A,B" },
    "ab_div_1000": { "description": "value = ((A × 256) + B) / 1000", "args": "A,B" },
    "ab_div_32768": { "description": "value = ((A × 256) + B) / 32768", "args": "A,B" },
    "ab_bitmask": { "description": "Побитовая маска из A,B", "args": "A,B,C,D" },
    "abcd_identity": { "description": "value = (A<<24) + (B<<16) + (C<<8) + D", "args": "A,B,C,D" },
    "raw_4byte": { "description": "Сырые 4 байта: A,B,C,D", "args": "A,B,C,D" }
  }
