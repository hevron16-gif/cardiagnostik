<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarDiagnosticApp.Models"
             x:Class="CarDiagnosticApp.Pages.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Заголовок -->
            <Label Text="🔧 АвтоДиагностика AI"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- Версия -->
            <Label x:Name="VersionLabel"
                   Text="v1.0.20"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

            <!-- ⚠️ Офлайн-баннер -->
            <Frame x:Name="OfflineBanner"
                   IsVisible="False"
                   BackgroundColor="#FFF3E0"
                   BorderColor="#FF9800"
                   CornerRadius="10"
                   Padding="12"
                   HasShadow="False">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="⚠️"
                           FontSize="24"
                           VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Офлайн-режим"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#E65100"/>
                        <Label Text="Интернет недоступен. Используются локальные данные."
                               FontSize="12"
                               TextColor="#BF360C"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Статус -->
            <Label x:Name="StatusLabel"
                   Text="Статус: готов"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

            <!-- Индикатор онлайн -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <BoxView x:Name="ConnectivityDot"
                         WidthRequest="10"
                         HeightRequest="10"
                         CornerRadius="5"
                         Color="#4CAF50"
                         VerticalOptions="Center"/>
                <Label x:Name="ConnectivityLabel"
                       Text="Онлайн"
                       FontSize="12"
                       TextColor="Gray"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- ═══ 4 ГЛАВНЫЕ КНОПКИ ═══ -->
            <Grid ColumnSpacing="12" RowSpacing="12"
                  HorizontalOptions="Fill"
                  MaximumWidthRequest="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <!-- 1. Диагностика -->
                <Button x:Name="ScanButton"
                        Grid.Row="0" Grid.Column="0"
                        Text="🔍&#10;Диагностика"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontSize="16"
                        CornerRadius="16"
                        LineBreakMode="WordWrap"
                        HeightRequest="120"/>

                <!-- 2. Диагностика ИИ -->
                <Button x:Name="DiagnoseButton"
                        Grid.Row="0" Grid.Column="1"
                        Text="🤖&#10;Диагностика ИИ"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        FontSize="16"
                        CornerRadius="16"
                        LineBreakMode="WordWrap"
                        HeightRequest="120"
                        IsEnabled="False"/>

                <!-- 3. Сброс ошибок -->
                <Button x:Name="ClearButton"
                        Grid.Row="1" Grid.Column="0"
                        Text="🔄&#10;Сброс ошибок"
                        BackgroundColor="#2D2D2D"
                        TextColor="#FFC107"
                        FontSize="16"
                        CornerRadius="16"
                        LineBreakMode="WordWrap"
                        HeightRequest="120"
                        BorderColor="#FFC107"
                        BorderWidth="1"
                        IsEnabled="False"
                        Clicked="OnClearClicked"/>

                <!-- 4. Графики -->
                <Button x:Name="GraphButton"
                        Grid.Row="1" Grid.Column="1"
                        Text="📈&#10;Графики"
                        BackgroundColor="#1565C0"
                        TextColor="White"
                        FontSize="16"
                        CornerRadius="16"
                        LineBreakMode="WordWrap"
                        HeightRequest="120"
                        IsEnabled="False"
                        Clicked="OnGraphClicked"/>
            </Grid>

            <!-- VIN -->
            <Label x:Name="VinLabel"
                   FontFamily="InterRegular"
                   FontSize="12"
                   TextColor="#6E6E6E"
                   IsVisible="False"
                   HorizontalOptions="Center"/>

            <!-- Карточка авто -->
            <Border x:Name="VehicleInfoCard"
                    IsVisible="False"
                    StrokeThickness="1"
                    Stroke="#1565C0"
                    BackgroundColor="#E3F2FD"
                    Padding="12,8"
                    StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Авто определено по VIN"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#1565C0"/>
                    <Label x:Name="VehicleInfoLabel"
                           FontSize="14"
                           TextColor="#0D47A1"/>
                </VerticalStackLayout>
            </Border>

            <!-- Выбор марки/модели (компактно) -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Марка автомобиля" FontSize="14" FontAttributes="Bold"/>
                <Picker x:Name="pickerBrand"
                        Title="Выберите марку"
                        FontSize="16"
                        SelectedIndexChanged="OnBrandSelected"/>

                <Label Text="Модель" FontSize="14" FontAttributes="Bold"/>
                <Picker x:Name="pickerModel"
                        Title="Сначала выберите марку"
                        FontSize="16"
                        IsEnabled="False"/>
            </VerticalStackLayout>

            <!-- Ошибки -->
            <Label x:Name="CurrentErrorsHeader"
                   FontFamily="InterBold"
                   FontSize="16"
                   TextColor="#F44336"
                   IsVisible="False"/>

            <CollectionView x:Name="CurrentErrorsList"
                            HeightRequest="100"
                            IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ObdError"
                                  xmlns:models="clr-namespace:CarDiagnosticApp.Models">
                        <HorizontalStackLayout Spacing="8" Padding="6">
                            <Border BackgroundColor="#F44336"
                                    StrokeThickness="0"
                                    Padding="10,5"
                                    StrokeShape="RoundRectangle 6">
                                <Label Text="{Binding Code}"
                                       FontFamily="InterBold" FontSize="14" TextColor="White"/>
                            </Border>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="PendingErrorsHeader"
                   FontFamily="InterBold"
                   FontSize="16"
                   TextColor="#FFC107"
                   IsVisible="False"/>

            <CollectionView x:Name="PendingErrorsList"
                            HeightRequest="100"
                            IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ObdError"
                                  xmlns:models="clr-namespace:CarDiagnosticApp.Models">
                        <HorizontalStackLayout Spacing="8" Padding="6">
                            <Frame BackgroundColor="#FFC107"
                                   CornerRadius="6" Padding="10,5" HasShadow="False">
                                <Label Text="{Binding Code}"
                                       FontFamily="InterBold" FontSize="14" TextColor="Black"/>
                            </Frame>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="PermanentErrorsHeader"
                   FontFamily="InterBold"
                   FontSize="16"
                   TextColor="#64B5F6"
                   IsVisible="False"/>

            <CollectionView x:Name="PermanentErrorsList"
                            HeightRequest="100"
                            IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ObdError"
                                  xmlns:models="clr-namespace:CarDiagnosticApp.Models">
                        <HorizontalStackLayout Spacing="8" Padding="6">
                            <Frame BackgroundColor="#1565C0"
                                   CornerRadius="6" Padding="10,5" HasShadow="False">
                                <Label Text="{Binding Code}"
                                       FontFamily="InterBold" FontSize="14" TextColor="White"/>
                            </Frame>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Дополнительные функции (скрытые кнопки для совместимости) -->
            <Button x:Name="TestModeButton"
                    Text="🧪 Тестовый режим (без авто)"
                    BackgroundColor="#FF9800"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="10"
                    IsVisible="False"/>

            <Button x:Name="DashboardButton"
                    Text="📊 Дашборд"
                    BackgroundColor="#7C4DFF"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="10"
                    IsEnabled="False"
                    IsVisible="False"
                    Clicked="OnDashboardClicked"/>

            <Button x:Name="HistoryButton"
                    Text="📋 История диагностик"
                    BackgroundColor="#2D2D2D"
                    TextColor="#1565C0"
                    FontSize="14"
                    BorderColor="#1565C0"
                    BorderWidth="1"
                    CornerRadius="10"
                    IsVisible="False"
                    Clicked="OnHistoryClicked"/>

            <Button x:Name="AnalysisButton"
                    Text="📈 Анализ истории ошибок"
                    BackgroundColor="#00BCD4"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="10"
                    IsEnabled="False"
                    IsVisible="False"
                    Clicked="OnAnalysisClicked"/>

            <Button x:Name="HistoryErrorsButton"
                    Text="📋 Анализ сохранённых ошибок"
                    BackgroundColor="#9C27B0"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="10"
                    IsEnabled="False"
                    IsVisible="False"
                    Clicked="OnHistoryErrorsClicked"/>

            <Button x:Name="KnowledgeButton"
                    Text="📚 База знаний OBD2"
                    BackgroundColor="#2D2D2D"
                    TextColor="#1565C0"
                    FontSize="14"
                    BorderColor="#1565C0"
                    BorderWidth="1"
                    CornerRadius="10"
                    IsVisible="False"
                    Clicked="OnKnowledgeClicked"/>

            <Button x:Name="SchemeButton"
                    Text="🔧 Схема узлов"
                    BackgroundColor="#2D2D2D"
                    TextColor="#1565C0"
                    FontSize="14"
                    BorderColor="#1565C0"
                    BorderWidth="1"
                    CornerRadius="10"
                    IsVisible="False"
                    Clicked="OnSchemeClicked"/>

            <Button x:Name="CodingButton"
                    Text="🔧 Скрытые функции"
                    BackgroundColor="#2D2D2D"
                    TextColor="#1565C0"
                    FontSize="14"
                    BorderColor="#1565C0"
                    BorderWidth="1"
                    CornerRadius="10"
                    IsVisible="False"
                    Clicked="OnCodingClicked"/>

            <Button x:Name="AdminButton"
                    Text="⚙️ Панель администратора"
                    BackgroundColor="Transparent"
                    TextColor="#6E6E6E"
                    FontSize="12"
                    CornerRadius="10"
                    IsVisible="False"
                    Clicked="OnAdminClicked"/>

            <Button x:Name="ManualUpdateButton"
                    Text="🔄 Обновить вручную"
                    BackgroundColor="Transparent"
                    TextColor="#6E6E6E"
                    FontSize="12"
                    CornerRadius="10"
                    IsVisible="False"
                    Clicked="OnManualUpdateClicked"/>

            <Button x:Name="SyncButton"
                    Text="☁️ Синхронизация"
                    BackgroundColor="#1565C0"
                    TextColor="White"
                    FontSize="12"
                    CornerRadius="10"
                    IsVisible="False"
                    Clicked="OnSyncClicked"/>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               Color="#2196F3"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
