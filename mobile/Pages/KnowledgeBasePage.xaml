<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarDiagnosticApp.Models"
             x:Class="CarDiagnosticApp.Pages.KnowledgeBasePage"
             Title="База знаний OBD2"
             BackgroundColor="{StaticResource DarkBackground}">

     <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="0">

        <!-- Заголовок -->
        <VerticalStackLayout Grid.Row="0" Padding="20,15,20,5" Spacing="6">
            <Label Text="📚 База знаний OBD2"
                   FontFamily="InterBold"
                   FontSize="24"
                   TextColor="{StaticResource LightOnDarkBackground}" />
            <Label Text="Справочник кодов ошибок с расшифровкой"
                   FontFamily="Inter"
                   FontSize="13"
                   TextColor="{StaticResource Gray400}" />
            <Label x:Name="LabelUpdated"
                   FontFamily="Inter"
                   FontSize="11"
                   TextColor="{StaticResource Gray500}" />
        </VerticalStackLayout>

        <!-- Поиск -->
        <Border Grid.Row="1"
                Stroke="{StaticResource Gray500}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource DarkSecondaryBackground}"
                Padding="4,0"
                Margin="20,8">
            <SearchBar x:Name="SearchBar"
                       Placeholder="Поиск по коду или описанию"
                       PlaceholderColor="{StaticResource Gray400}"
                       TextColor="{StaticResource LightOnDarkBackground}"
                       BackgroundColor="Transparent"
                       CancelButtonColor="{StaticResource Primary}"
                       FontFamily="Inter"
                       FontSize="14"
                       TextChanged="OnSearchTextChanged" />
        </Border>

        <!-- Фильтр по марке -->
        <Border Grid.Row="2"
                Stroke="{StaticResource Gray500}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource DarkSecondaryBackground}"
                Padding="8,2"
                Margin="20,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="🚗"
                       FontSize="18"
                       VerticalOptions="Center" />
                <Picker x:Name="BrandPicker"
                        Grid.Column="1"
                        Title="Все марки"
                        TitleColor="{StaticResource Gray400}"
                        TextColor="{StaticResource LightOnDarkBackground}"
                        FontFamily="Inter"
                        FontSize="14"
                        BackgroundColor="Transparent"
                        SelectedIndexChanged="OnBrandSelected" />
            </Grid>
        </Border>

        <!-- Счётчик -->
        <Label x:Name="LabelCount"
               Grid.Row="3"
               Margin="20,6,20,0"
               FontFamily="Inter"
               FontSize="12"
               TextColor="{StaticResource Gray400}" />

        <!-- Список кодов -->
        <CollectionView x:Name="CodeList"
                        Grid.Row="4"
                        Margin="20,0"
                        IsGrouped="True">

            <!-- Заголовок группы -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid Padding="0,14,0,4" BackgroundColor="{StaticResource DarkBackground}">
                        <Label Text="{Binding Key}"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Primary}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- Карточка кода -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:KnowledgeItem">
                    <Border Stroke="{StaticResource Gray600}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource DarkSecondaryBackground}"
                            Padding="14"
                            Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              RowSpacing="8">

                            <!-- Бейдж кода -->
                            <Border Grid.Column="0" Grid.Row="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{StaticResource Primary}"
                                    Padding="10,4"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Code}"
                                       FontFamily="InterBold"
                                       FontSize="14"
                                       TextColor="White" />
                            </Border>

                            <!-- Описание -->
                            <Label Grid.Column="1" Grid.Row="0"
                                   Text="{Binding Description}"
                                   FontFamily="InterSemiBold"
                                   FontSize="14"
                                   TextColor="{StaticResource LightOnDarkBackground}"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2"
                                   VerticalOptions="Center" />

                            <!-- Детали (раскрываются) -->
                            <VerticalStackLayout Grid.Column="0" Grid.ColumnSpan="2"
                                                 Grid.Row="1"
                                                 IsVisible="{Binding IsExpanded}"
                                                 Spacing="6">

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource Gray600}"
                                         Margin="0,2" />

                                <Label Text="🔧 Причины"
                                       FontFamily="InterSemiBold"
                                       FontSize="13"
                                       TextColor="{StaticResource WarningAmber}" />
                                <Label Text="{Binding Causes}"
                                       FontFamily="Inter"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray200}"
                                       LineBreakMode="WordWrap" />

                                <Label Text="⚠ Симптомы"
                                       FontFamily="InterSemiBold"
                                       FontSize="13"
                                       TextColor="#FF7043"
                                       Margin="0,4,0,0" />
                                <Label Text="{Binding Symptoms}"
                                       FontFamily="Inter"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray200}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Пустой список -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="8"
                                     Padding="40">
                    <Label Text="🔍"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="Коды не найдены"
                           FontFamily="InterSemiBold"
                           FontSize="18"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center" />
                    <Label Text="Попробуйте изменить запрос"
                           FontFamily="Inter"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>
</ContentPage>
